# Copy to store-credentials.env (same folder) and fill in. Never commit the copy.
# Scopes and where each value comes from: docs/bigcommerce.md › Credentials.

# Store-level API account (control panel › Settings › Store-level API accounts).
# Scopes: Checkout Content: modify · Information & Settings: read-only · Customers Login: login
store_hash=
access_token=
client_id=
client_secret=

# Optional. Storefront origin, e.g. https://example.mybigcommerce.com. Looked up from the API if empty.
storefront_url=

# Only for `npm run deploy -- <widget> --hosted` (control panel › Settings › File access (WebDAV)).
# store_webdav_path looks like https://store-<hash>.mybigcommerce.com/dav
store_webdav_path=
webdav_username=
webdav_password=
